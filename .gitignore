/target
# Criterion baseline store (machine-specific; see benches/BASELINE.md for the committed
# snapshot). Kept here rather than target/ so baselines survive `cargo clean`.
/.criterion
# Per-user, machine-specific Claude Code settings.
/.claude/settings.local.json
# Benchmark fixtures are generated on demand by benches/data/generate.py (up to ~21MB);
# regenerate rather than commit them.
/benches/data/*.json
/benches/backend-harness/target
/benches/readme-tables/target
